{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "rewrites": [
    {
      "source": "/musings",
      "destination": "/index.html"
    },
    {
      "source": "/musings/",
      "destination": "/index.html"
    },
    {
      "source": "/musings/:path(.+)/",
      "destination": "/:path"
    },
    {
      "source": "/musings/:path*",
      "destination": "/:path*"
    }
  ]
}
